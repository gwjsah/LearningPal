# Copy this file to application.properties and fill in your own values. Never commit application.properties.

# ===================================================================
# LearningPal Backend Configuration
# ===================================================================

server.port=8080

# -------------------------------------------------------------------
# Database Configuration (MySQL)
# -------------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/learningpal?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Your local MySQL database username (e.g. root)
spring.datasource.username=YOUR_DB_USERNAME
# Your local MySQL database password
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA & Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# -------------------------------------------------------------------
# JWT Security Configuration
# -------------------------------------------------------------------
# 256-bit secret key used to sign and verify HS256 JWT tokens.
# Must be at least 256 bits (32 bytes) when base64/hex decoded.
# Generate a fresh secure key with: openssl rand -base64 32
app.jwt.secret=CHANGE_ME_BASE64_256_BIT
# 24 hours in milliseconds (24 * 60 * 60 * 1000)
app.jwt.expiration-ms=86400000

# -------------------------------------------------------------------
# CORS Configuration
# -------------------------------------------------------------------
app.cors.allowed-origins=http://localhost:5173

# -------------------------------------------------------------------
# File Upload & Text Extraction Configuration (Phase B)
# -------------------------------------------------------------------
# Storage directory for uploaded documents (must be outside web root/classpath)
app.files.storage-dir=./storage/resources
# Maximum individual file size in bytes (default 10 MB = 10485760 bytes)
app.files.max-file-size=10485760
# Hard cap on PDF page count
app.files.max-pages=300
# Hard cap on extracted text character count
app.files.max-extracted-chars=500000
# Maximum cumulative storage quota per teacher in bytes (default 200 MB = 209715200 bytes)
app.files.teacher-storage-quota-bytes=209715200
# Maximum active file resources permitted per subject
app.files.max-active-files-per-subject=25
# In-memory hourly upload rate limit per teacher
app.files.max-uploads-per-hour=20

# Spring standard multipart limits (aligned with 10 MB file ceiling)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=12MB

# -------------------------------------------------------------------
# Initial Admin Seed Credentials
# On application startup, if no admin exists, this account will be created automatically.
# -------------------------------------------------------------------
# Email address for the initial seed administrator account
app.admin.email=${APP_ADMIN_EMAIL:admin@example.com}
# Strong password for the initial seed administrator (minimum 8 characters, at least 1 letter and 1 number)
app.admin.password=${APP_ADMIN_PASSWORD:REPLACE_WITH_STRONG_PASSWORD}
app.admin.full-name=${APP_ADMIN_NAME:LearningPal System Admin}

# -------------------------------------------------------------------
# Platform Super Administrator Credentials
# Platform-level owner who creates institutions and their first admins.
# Leave blank or unset to skip super-admin seeding.
# -------------------------------------------------------------------
app.superadmin.email=${APP_SUPERADMIN_EMAIL:superadmin@learningpal.edu}
app.superadmin.password=${APP_SUPERADMIN_PASSWORD:REPLACE_WITH_STRONG_PASSWORD}
app.superadmin.full-name=${APP_SUPERADMIN_NAME:LearningPal Super Admin}

# -------------------------------------------------------------------
# Pilot Learning Data Seeder
# When true, automatically seeds the pilot subject, topics, questions, and resources if empty.
# -------------------------------------------------------------------
app.seed.enabled=true

# -------------------------------------------------------------------
# Diagnostic Gap Analysis Engine Configuration
# -------------------------------------------------------------------
# Minimum score percentage to be categorized as a STRENGTH (default 80.0)
app.analysis.strength-threshold=80.0
# Score percentage threshold below which is categorized as a GAP (default 60.0)
app.analysis.gap-threshold=60.0
# Minimum distinct questions evaluated per topic before categorizing beyond INSUFFICIENT_DATA
app.analysis.min-questions=3

# -------------------------------------------------------------------
# Realistic Demo Data Populator (Opt-in)
# Deterministically seeds realistic demo accounts, classes, attempts,
# overrides, interventions, and synthetic validation labels.
# NOTE: If you import `database_backup.sql`, all realistic demo data is
# ALREADY included! Keep enabled=false when using database_backup.sql.
# -------------------------------------------------------------------
# Set to true only if starting with a clean/empty DB and wanting auto-generated demo data:
app.seed.demo.enabled=false
# When true, cleans up any existing demo data before re-populating (default: false)
app.seed.demo.reset=false
# Shared password for demo accounts if auto-populating (minimum 8 characters, at least 1 letter and 1 number)
app.seed.demo.password=DemoPassword123!
# Safety guard: refuse to run on remote/production databases unless explicitly permitted (default: false)
app.seed.demo.allow-remote=false

# -------------------------------------------------------------------
# Local LLM Question Drafting Configuration (Phase C)
# Connects to a local OpenAI-compatible server (e.g. LM Studio on localhost:1234).
# No document text, prompts, or drafts are ever sent to external clouds.
# -------------------------------------------------------------------
# Master feature flag enabling AI question drafting (default: false)
app.llm.enabled=false
# Base URL of the local LM Studio OpenAI-compatible server
app.llm.base-url=http://localhost:1234
# Target model identifier (e.g. qwen/qwen3-14b)
app.llm.model=qwen/qwen3-14b
# Request timeout per LLM call in seconds (default: 60)
app.llm.request-timeout-seconds=60
# Character limit per document text chunk analyzed (default: 5000)
app.llm.chunk-chars=5000
# Maximum drafts generated per job (hard limit 30)
app.llm.max-drafts-per-job=30
# Hourly generation limit per teacher (default: 5)
app.llm.max-jobs-per-teacher-per-hour=5
# Sampling temperature for factual extraction (default: 0.2)
app.llm.temperature=0.2
# Suffix appended to user prompt (e.g. /no_think to suppress verbose reasoning blocks)
app.llm.user-suffix=/no_think





# Copy this file to application.properties and fill in your own values. Never commit application.properties.

# ===================================================================
# LearningPal Backend Configuration
# ===================================================================

server.port=8080

# -------------------------------------------------------------------
# Database Configuration (MySQL)
# -------------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/learningpal?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Your local MySQL database username (e.g. root)
spring.datasource.username=YOUR_DB_USERNAME
# Your local MySQL database password
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA & Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# -------------------------------------------------------------------
# JWT Security Configuration
# -------------------------------------------------------------------
# 256-bit secret key used to sign and verify HS256 JWT tokens.
# Generate one with: openssl rand -base64 32 (must be base64 and at least 32 bytes).
app.jwt.secret=REPLACE_WITH_BASE64_SECRET
# 24 hours in milliseconds (24 * 60 * 60 * 1000)
app.jwt.expiration-ms=86400000

# -------------------------------------------------------------------
# CORS Configuration
# -------------------------------------------------------------------
app.cors.allowed-origins=http://localhost:5173

# -------------------------------------------------------------------
# Initial Admin Seed Credentials
# On application startup, if no admin exists, this account will be created automatically.
# -------------------------------------------------------------------
# Email address for the initial seed administrator account
app.admin.email=${APP_ADMIN_EMAIL:admin@example.com}
# Strong password for the initial seed administrator (minimum 8 characters, at least 1 letter and 1 number)
app.admin.password=${APP_ADMIN_PASSWORD:REPLACE_WITH_STRONG_PASSWORD}
app.admin.full-name=${APP_ADMIN_NAME:LearningPal System Admin}

# -------------------------------------------------------------------
# Platform Super Administrator Credentials
# Platform-level owner who creates institutions and their first admins.
# Leave blank or unset to skip super-admin seeding.
# -------------------------------------------------------------------
app.superadmin.email=${APP_SUPERADMIN_EMAIL:superadmin@learningpal.edu}
app.superadmin.password=${APP_SUPERADMIN_PASSWORD:REPLACE_WITH_STRONG_PASSWORD}
app.superadmin.full-name=${APP_SUPERADMIN_NAME:LearningPal Super Admin}

# -------------------------------------------------------------------
# Pilot Learning Data Seeder
# When true, automatically seeds the pilot subject, topics, questions, and resources if empty.
# -------------------------------------------------------------------
app.seed.enabled=true

# -------------------------------------------------------------------
# Diagnostic Gap Analysis Engine Configuration
# -------------------------------------------------------------------
# Minimum score percentage to be categorized as a STRENGTH (default 80.0)
app.analysis.strength-threshold=80.0
# Score percentage threshold below which is categorized as a GAP (default 60.0)
app.analysis.gap-threshold=60.0
# Minimum distinct questions evaluated per topic before categorizing beyond INSUFFICIENT_DATA
app.analysis.min-questions=3



# ===================================================================
# LearningPal Environment Variables Template
# Copy this file to `.env` at the repository root and fill in real values.
# NEVER commit `.env` to version control!
# ===================================================================

# -------------------------------------------------------------------
# Database Credentials (MySQL)
# -------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/learningpal?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# -------------------------------------------------------------------
# JWT Security Secret (minimum 256-bit / 32+ bytes)
# Generate a fresh 256-bit base64 secret with:
#   openssl rand -base64 32
# -------------------------------------------------------------------
APP_JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# -------------------------------------------------------------------
# Google AI Studio / Gemini API Key (optional; required when app.llm.provider=gemini)
# Obtain a key at https://aistudio.google.com/
# -------------------------------------------------------------------
GEMINI_API_KEY=CHANGE_ME

# -------------------------------------------------------------------
# Initial Admin & Seed Credentials (optional)
# -------------------------------------------------------------------
APP_ADMIN_EMAIL=admin@learningpal.edu
APP_ADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS
APP_SUPERADMIN_EMAIL=superadmin@learningpal.edu
APP_SUPERADMIN_PASSWORD=CHANGE_ME_MIN_8_CHARS
APP_SEED_DEMO_ENABLED=true
APP_SEED_DEMO_PASSWORD=CHANGE_ME_MIN_8_CHARS
